[Unit]
Description=Rust clan Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rust-clan-bot
EnvironmentFile=/opt/rust-clan-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rust-clan-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
